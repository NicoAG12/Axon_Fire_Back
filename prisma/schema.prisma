generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum user_roles {
  USER
  ADMIN
}

enum tipos_respuesta {
  PENDIENTE
  ACEPTADO
  RECHAZADO
}

enum tipos_comunicacion {
  SUMINISTROS
  APOYO
  INFORMACION
}

enum estado_camion {
  ACTIVO
  INACTIVO
}

enum estado_control_herramienta {
  CHEQUEADO
  FALTANTE
}

enum estado_informe {
  BORRADOR
  FINALIZADO
}

enum categoria_poi {
  HIDRANTE
  SALUD
  MATERIAL_PELIGROSO
  CUARTEL_APOYO
}

enum nivel_prioridad {
  ALTA
  MEDIA
  BAJA
}

model tokens_dispositivos {
  id         String   @id @default(uuid())
  usuarioId  usuarios @relation(fields: [usuario_id], references: [id])
  usuario_id String
  token      String   @unique
  plataforma String?
  fecha_alta DateTime @default(now())
}

model usuarios {
  id                        String                        @id @default(uuid())
  nombre_usuario            String                        @unique
  password                  String
  rol                       user_roles
  activo                    Boolean                       @default(true)
  bombero                   bomberos?
  respuestas_alertas        respuestas_alertas[]
  registros_comunicacion    registros_comunicacion[]
  alertas                   alerta[]
  tokens_dispositivos       tokens_dispositivos[]
  checklistCamionesDiarios  checklist_camiones_diario[]
  checklistBolsosEmergencia checklist_bolsos_emergencia[]
  checklistsCuartel         checklist_cuartel[]
  pois_creados              puntos_interes[]
  controles_fluidos         control_fluidos[]
  mantenimientos            mantenimiento_herramientas[]

  @@map("users")
}

model bomberos_rangos {
  id         String     @id @default(uuid())
  nombre_rol String
  bomberos   bomberos[]
}

model bomberos {
  id           String          @id @default(uuid())
  usuarioId    usuarios        @relation(fields: [usuario_id], references: [id])
  usuario_id   String          @unique
  rangoBombero bomberos_rangos @relation(fields: [rango], references: [id])
  rango        String
  nombre       String
  apellido     String
}

model categorias_alerta {
  id                   String                @id @default(uuid())
  nombre_categoria     String                @unique
  subcategorias_alerta subcategoria_alerta[]
}

model subcategoria_alerta {
  id                   String            @id @default(uuid())
  categoriaAlerta      categorias_alerta @relation(fields: [categoria_alerta_id], references: [id])
  categoria_alerta_id  String
  nombre_sub_categoria String            @unique
  alertas              alerta[]
}

model estados_alerta {
  id            String   @id @default(uuid())
  nombre_estado String   @unique
  alertas       alerta[]
}

model alerta {
  id                         String                        @id @default(uuid())
  subCategoriaAlerta         subcategoria_alerta           @relation(fields: [sub_categoria_alerta_id], references: [id])
  sub_categoria_alerta_id    String
  ubicacion                  String
  latitud                    Float?
  longitud                   Float?
  prioridad                  nivel_prioridad               @default(MEDIA)
  observaciones              String
  estadoAlerta               estados_alerta                @relation(fields: [estado_alerta_id], references: [id])
  estado_alerta_id           String
  fecha_hora                 DateTime
  respuestas                 respuestas_alertas[]
  registros_comunicacion     registros_comunicacion[]
  usuarioID                  usuarios                      @relation(fields: [usuario_alta_alerta], references: [id])
  usuario_alta_alerta        String
   fecha_hora_finalizacion    DateTime?
  duracion_total_alerta      Float?                          @default(0)
  checklistBolsosEmergencias checklist_bolsos_emergencia[]
  informe                    informes_emergencia?
}

model respuestas_alertas {
  id               String          @id @default(uuid())
  alertaId         alerta          @relation(fields: [alerta_id], references: [id])
  alerta_id        String
  usuarioId        usuarios        @relation(fields: [usuario_id], references: [id])
  usuario_id       String
  estado_respuesta tipos_respuesta
  fecha_hora       DateTime
}

model registros_comunicacion {
  id                String             @id @default(uuid())
  alertaId          alerta             @relation(fields: [alerta_id], references: [id])
  alerta_id         String
  usuarioId         usuarios           @relation(fields: [usuario_id], references: [id])
  usuario_id        String
  mensaje           String
  fecha_hora        DateTime
  tipo_comunicacion tipos_comunicacion
}

model camiones {
  id            String                      @id @default(uuid())
  nombre_camion String
  estado        estado_camion
  sectores            sectores_camion[]
  inventario          camiones_inventario[]
  checklists          checklist_camiones_diario[]
  controles_fluidos   control_fluidos[]
}

model sectores_camion {
  id            String                @id @default(uuid())
  camionId      camiones              @relation(fields: [camion_id], references: [id], onDelete: Cascade)
  camion_id     String
  nombre_sector String
  inventarios   camiones_inventario[]
}

model herramientas {
  id                  String                @id @default(uuid())
  nombre_herramienta  String
  cantidad_disponible Int
  inventarios         camiones_inventario[]
  bolsos_inventarios  bolsos_inventario[]
  detalles_checklist  checklist_detalle_cuartel[]
  mantenimientos      mantenimiento_herramientas[]
}

model camiones_inventario {
  id                   String              @id @default(uuid())
  camionId             camiones            @relation(fields: [camion_id], references: [id], onDelete: Cascade)
  camion_id            String
  sectorId             sectores_camion     @relation(fields: [sector_id], references: [id], onDelete: Cascade)
  sector_id            String
  herramientaId        herramientas        @relation(fields: [herramienta_id], references: [id])
  herramienta_id       String
  cantidad_herramienta Int
  checklists_detalle   checklist_detalle[]
}

model checklist_camiones_diario {
  id            String              @id @default(uuid())
  fecha_control DateTime            @default(now())
  camionId      camiones            @relation(fields: [camion_id], references: [id])
  camion_id     String
  usuarioId     usuarios            @relation(fields: [usuario_id], references: [id])
  usuario_id    String
  detalles      checklist_detalle[]
}

model checklist_detalle {
  id            String                     @id @default(uuid())
  checklistId   checklist_camiones_diario  @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  checklist_id  String
  inventarioId  camiones_inventario        @relation(fields: [inventario_id], references: [id])
  inventario_id String
  controlado    estado_control_herramienta
  observaciones String?
}

model bolsos {
  id                 String                        @id @default(uuid())
  nombre_bolso       String
  bolsos_inventarios bolsos_inventario[]
  checklists         checklist_bolsos_emergencia[]
}

model bolsos_inventario {
  id                   String                    @id @default(uuid())
  bolsoId              bolsos                    @relation(fields: [bolso_id], references: [id])
  bolso_id             String
  herramientaId        herramientas              @relation(fields: [herramienta_id], references: [id])
  herramienta_id       String
  cantidad_herramienta Int
  checklists_detalle   checklist_detalle_bolso[]
}

model checklist_bolsos_emergencia {
  id            String                    @id @default(uuid())
  fecha_control DateTime                  @default(now())
  usuarioId     usuarios                  @relation(fields: [usuario_id], references: [id])
  usuario_id    String
  alertaId      alerta?                   @relation(fields: [alerta_id], references: [id])
  alerta_id     String?
  bolsoId       bolsos                    @relation(fields: [bolso_id], references: [id])
  bolso_id      String
  detalles      checklist_detalle_bolso[]
}

model checklist_detalle_bolso {
  id            String                      @id @default(uuid())
  checklistId   checklist_bolsos_emergencia @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  checklist_id  String
  inventarioId  bolsos_inventario           @relation(fields: [inventario_id], references: [id])
  inventario_id String
  controlado    estado_control_herramienta
  observaciones String?
}

model checklist_cuartel {
  id            String   @id @default(uuid())
  fecha_control DateTime @default(now())
  usuario_id    String

  usuario     usuarios                    @relation(fields: [usuario_id], references: [id])
  detalles    checklist_detalle_cuartel[]
}

model checklist_detalle_cuartel {
  id             String                   @id @default(uuid())
  checklist_id   String
  herramienta_id String
  controlado     estado_control_herramienta
  observaciones  String?

  checklist    checklist_cuartel      @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  herramienta  herramientas           @relation(fields: [herramienta_id], references: [id])
}

model informes_emergencia {
  id                  String         @id @default(uuid())
  alertaId            alerta         @relation(fields: [alerta_id], references: [id])
  alerta_id           String         @unique
  observaciones_admin String?
  detalles_propiedad  String?
  estado_informe      estado_informe @default(BORRADOR)
  creado_por          String
  fecha_creacion      DateTime       @default(now())
  fecha_actualizacion DateTime       @updatedAt
}

model puntos_interes {
  id          String        @id @default(uuid())
  categoria   categoria_poi
  nombre      String
  descripcion String?
  latitud     Float
  longitud    Float
  activo      Boolean       @default(true)
  creado_por  String
  usuario     usuarios      @relation(fields: [creado_por], references: [id])
}

model control_fluidos {
  id                    String   @id @default(uuid())
  camionId              camiones @relation(fields: [camion_id], references: [id])
  camion_id             String
  usuarioId             usuarios @relation(fields: [usuario_id], references: [id])
  usuario_id            String
  fecha_control         DateTime @default(now())
  aceite_motor          String
  liquido_refrigerante  String
  liquido_frenos        String
  liquido_direccion     String
  observaciones         String?
}

model mantenimiento_herramientas {
  id                  String       @id @default(uuid())
  herramientaId       herramientas @relation(fields: [herramienta_id], references: [id])
  herramienta_id      String
  usuarioId           usuarios     @relation(fields: [usuario_id], references: [id])
  usuario_id          String
  fecha_mantenimiento DateTime     @default(now())
  nivel_aceite        String
  estado_mangueras    String
  presion_trabajo     String
  estado_limpieza     String
  observaciones       String?
}
