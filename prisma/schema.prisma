generator client {
  provider   = "prisma-client"
  output ="../generated"
}

datasource db {
  provider = "postgresql"
}

enum user_roles {
  USER
  ADMIN
}

enum tipos_respuesta {
  ACEPTADO
  RECHAZADO
}

enum tipos_comunicacion {
  SUMINISTROS
  APOYO
  INFORMACION
}

model usuarios {
  id                     String                   @id @default(uuid())
  nombre_usuario         String                   @unique
  password               String
  rol                    user_roles
  bombero                bomberos?
  respuestas_alertas     respuestas_alertas[]
  registros_comunicacion registros_comunicacion[]
  alertas                alerta[]
  @@map("users")
}

model bomberos_rangos {
  id         String     @id   @default(uuid())
  nombre_rol String
  bomberos   bomberos[]
}

model bomberos {
  id           String          @id  @default(uuid())
  usuarioId    usuarios        @relation(fields: [usuario_id], references: [id])
  usuario_id   String          @unique
  rangoBombero bomberos_rangos @relation(fields: [rango], references: [id])
  rango        String
  nombre       String
  apellido     String
}

model categorias_alerta {
  id                   String                @id @default(uuid())
  nombre_categoria     String                @unique
  subcategorias_alerta subcategoria_alerta[]
}

model subcategoria_alerta {
  id                   String            @id @default(uuid())
  categoriaAlerta      categorias_alerta @relation(fields: [categoria_alerta_id], references: [id])
  categoria_alerta_id  String
  nombre_sub_categoria String            @unique
  alertas              alerta[]
}

model estados_alerta {
  id            String   @id @default(uuid())
  nombre_estado String   @unique
  alertas       alerta[]
}

model alerta {
  id                      String                   @id  @default(uuid())
  subCategoriaAlerta      subcategoria_alerta      @relation(fields: [sub_categoria_alerta_id], references: [id])
  sub_categoria_alerta_id String
  ubicacion               String
  observaciones           String
  estadoAlerta            estados_alerta           @relation(fields: [estado_alerta_id], references: [id])
  estado_alerta_id        String
  fecha_hora              DateTime
  respuestas              respuestas_alertas[]
  registros_comunicacion  registros_comunicacion[]
  usuarioID               usuarios                 @relation(fields: [usuario_alta_alerta], references: [id])
  usuario_alta_alerta     String                   
}

model respuestas_alertas {
  id               String          @id  @default(uuid())
  alertaId         alerta          @relation(fields: [alerta_id], references: [id])
  alerta_id        String
  usuarioId        usuarios        @relation(fields: [usuario_id], references: [id])
  usuario_id       String
  estado_respuesta tipos_respuesta
  fecha_hora       DateTime
}

model registros_comunicacion {
  id                String             @id @default(uuid())
  alertaId          alerta             @relation(fields: [alerta_id], references: [id])
  alerta_id         String
  usuarioId         usuarios           @relation(fields: [usuario_id], references: [id])
  usuario_id        String
  mensaje           String
  fecha_hora        DateTime
  tipo_comunicacion tipos_comunicacion
}
